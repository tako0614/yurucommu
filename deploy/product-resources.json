{
  "apiVersion": "yurucommu.com/product-resources/v1",
  "kind": "ProductResourceContract",
  "product": "yurucommu",
  "resources": [
    { "name": "app", "shape": "ModuleWorker" },
    { "name": "bundle", "shape": "WorkerBundle" },
    { "name": "version", "shape": "WorkerVersion" },
    { "name": "deployment", "shape": "WorkerDeployment" },
    { "name": "endpoint", "shape": "WorkerCustomDomain" },
    { "name": "database", "shape": "SQLiteDatabase" },
    { "name": "schema", "shape": "SQLiteMigrationSet" },
    { "name": "schema-application", "shape": "SQLiteMigrationApplication" },
    { "name": "cache", "shape": "EdgeKVNamespace" },
    { "name": "delivery", "shape": "AtLeastOnceQueue" },
    { "name": "delivery-dlq", "shape": "AtLeastOnceQueue" },
    { "name": "delivery-consumer", "shape": "QueueConsumer" },
    { "name": "retention", "shape": "WorkerCronTrigger" }
  ],
  "runtimeConnections": [
    { "name": "DB", "resource": "database" },
    { "name": "KV", "resource": "cache" },
    { "name": "DELIVERY_QUEUE", "resource": "delivery" },
    { "name": "DELIVERY_DLQ", "resource": "delivery-dlq" }
  ],
  "standardServices": [
    { "name": "MEDIA", "protocol": "com.amazonaws.s3", "required": true }
  ],
  "nativeHandlers": [
    { "name": "fetch", "resource": "endpoint" },
    { "name": "queue", "resource": "delivery-consumer" },
    { "name": "scheduled", "resource": "retention" }
  ],
  "outputs": [
    { "name": "launch_url", "source": "input", "input": "app_url" },
    {
      "name": "api_url",
      "source": "derived",
      "input": "app_url",
      "suffix": "/api"
    }
  ]
}
