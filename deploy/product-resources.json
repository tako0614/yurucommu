{
  "apiVersion": "yurucommu.com/product-resources/v1",
  "kind": "ProductResourceContract",
  "product": "yurucommu",
  "resources": [
    { "name": "app", "shape": "EdgeWorker" },
    { "name": "database", "shape": "RelationalDatabase" },
    { "name": "media", "shape": "ObjectBucket" },
    { "name": "cache", "shape": "KeyValueStore" },
    { "name": "delivery", "shape": "Queue" },
    { "name": "delivery-dlq", "shape": "Queue" },
    { "name": "retention", "shape": "Schedule" }
  ],
  "runtimeConnections": [
    { "name": "DB", "resource": "database", "projection": "sql.binding.v1" },
    { "name": "MEDIA", "resource": "media", "projection": "object.binding.v1" },
    { "name": "KV", "resource": "cache", "projection": "keyvalue.binding.v1" },
    {
      "name": "DELIVERY_QUEUE",
      "resource": "delivery",
      "projection": "queue.binding.v1"
    },
    {
      "name": "DELIVERY_DLQ",
      "resource": "delivery-dlq",
      "projection": "queue.binding.v1"
    }
  ],
  "outputs": [
    { "name": "launch_url", "interface": "http.request@1" },
    { "name": "api_url", "interface": "http.request@1" }
  ]
}
