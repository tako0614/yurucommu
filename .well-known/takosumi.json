{
  "apiVersion": "takosumi.com/v2.3",
  "kind": "Repository",
  "install": {
    "defaultModule": "deploy/takoform",
    "modules": {
      ".": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            },
            "helper": {
              "ja": "ワークスペース内で使うYurucommuの名前です。",
              "en": "The name of this Yurucommu service in the workspace."
            },
            "advanced": true
          },
          {
            "name": "app_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": true,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "Yurucommuの正規HTTPS originです。OpenTofuが同じ公開先を構成します。",
              "en": "The canonical HTTPS origin for Yurucommu. OpenTofu configures the same public endpoint."
            },
            "placeholder": "https://yurucommu.example.com",
            "advanced": true
          },
          {
            "name": "cloudflare_account_id",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "required": true,
            "label": {
              "ja": "Cloudflare account ID",
              "en": "Cloudflare account ID"
            },
            "helper": {
              "ja": "認証情報ではなく、OpenTofu resourceが対象accountを選ぶ公開IDです。認証情報はProvider Connectionから別に渡されます。",
              "en": "This is the public account selector used by OpenTofu resources, not a credential. Credentials are delivered separately through the Provider Connection."
            },
            "advanced": true
          },
          {
            "name": "cloudflare_workers_subdomain",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "subdomain",
            "required": true,
            "label": {
              "ja": "workers.dev subdomain",
              "en": "workers.dev subdomain"
            },
            "helper": {
              "ja": "公開URLが <service>.<subdomain>.workers.dev になるように指定します。",
              "en": "Set this so the public URL is <service>.<subdomain>.workers.dev."
            },
            "advanced": true
          },
          {
            "name": "notification_push_gateway_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "PushゲートウェイURL",
              "en": "Push gateway URL"
            },
            "advanced": true
          },
          {
            "name": "notification_push_web_push_public_key",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "required": false,
            "label": {
              "ja": "Web Push公開鍵",
              "en": "Web Push public key"
            },
            "advanced": true
          },
          {
            "name": "worker_name",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "実行サービス名",
              "en": "Runtime service name"
            },
            "advanced": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリース",
              "en": "Release"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "リリースURL",
              "en": "Release URL"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリースSHA-256",
              "en": "Release SHA-256"
            },
            "advanced": true
          }
        ],
        "features": [
          {
            "id": "notification-push",
            "optional": true,
            "label": {
              "ja": "プッシュ通知",
              "en": "Push notifications"
            },
            "inputs": [
              "notification_push_gateway_url",
              "notification_push_web_push_public_key"
            ]
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "app_url"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback/takos",
            "scopes": ["openid", "profile", "email"],
            "deliver": {
              "variables": {
                "accountsUrl": "takosumi_accounts_url",
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "yurucommu.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Yurucommu",
                  "icon": "/icons/yurucommu.svg"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": ["ui.open"],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          }
        ]
      },
      "deploy/takoform": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            },
            "helper": {
              "ja": "ワークスペース内で使うYurucommuの名前です。",
              "en": "The name of this Yurucommu service in the workspace."
            },
            "advanced": true
          },
          {
            "name": "app_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": true,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "Takoform Hostに接続する正規HTTPS originです。",
              "en": "The canonical HTTPS origin attached by the Takoform Host."
            },
            "placeholder": "https://yurucommu.example.com",
            "advanced": true
          }
        ],
        "sourceBuild": {
          "commands": [
            {
              "argv": ["bun", "install", "--frozen-lockfile"]
            },
            {
              "argv": ["bun", "run", "build:worker"]
            },
            {
              "argv": ["bun", "scripts/prepare-takoform-v1-source.ts"]
            }
          ],
          "outputs": [
            "deploy/takoform/.generated/yurucommu-worker.js",
            "deploy/takoform/.generated/migrations"
          ]
        },
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "app_url"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback/takos",
            "scopes": ["openid", "profile", "email"],
            "deliver": {
              "variables": {
                "accountsUrl": "takosumi_accounts_url",
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "yurucommu.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Yurucommu",
                  "icon": "/icons/yurucommu.svg"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": ["ui.open"],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
