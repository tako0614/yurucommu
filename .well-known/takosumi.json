{
  "apiVersion": "takosumi.com/v1",
  "kind": "Repository",
  "install": {
    "modules": {
      ".": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            },
            "helper": {
              "ja": "ワークスペース内で使うYurucommuの名前です。",
              "en": "The name of this Yurucommu service in the workspace."
            },
            "advanced": true
          },
          {
            "name": "app_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合はTakosumiが利用可能な公開URLを割り当てます。",
              "en": "Takosumi allocates an available public URL when omitted."
            },
            "placeholder": "https://yurucommu.example.com"
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "auth_password_hash",
            "source": {
              "kind": "user"
            },
            "role": "initial_secret",
            "type": "string",
            "format": "password",
            "required": false,
            "label": {
              "ja": "初期パスワード",
              "en": "Initial password"
            },
            "helper": {
              "ja": "パスワード認証を選んだ場合だけ入力します。",
              "en": "Enter this only when password authentication is selected."
            },
            "secret": true
          },
          {
            "name": "notification_push_gateway_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "PushゲートウェイURL",
              "en": "Push gateway URL"
            },
            "advanced": true
          },
          {
            "name": "notification_push_gateway_token",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "password",
            "required": false,
            "label": {
              "ja": "Pushゲートウェイトークン",
              "en": "Push gateway token"
            },
            "advanced": true,
            "secret": true
          },
          {
            "name": "notification_push_web_push_public_key",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "required": false,
            "label": {
              "ja": "Web Push公開鍵",
              "en": "Web Push public key"
            },
            "advanced": true
          },
          {
            "name": "worker_name",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "実行サービス名",
              "en": "Runtime service name"
            },
            "advanced": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリース",
              "en": "Release"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "リリースURL",
              "en": "Release URL"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリースSHA-256",
              "en": "Release SHA-256"
            },
            "advanced": true
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "app_url",
                "subdomain": "project_name"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback/takos",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "deliver": {
              "variables": {
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id"
              }
            }
          }
        ],
        "features": [
          {
            "id": "password-authentication",
            "optional": true,
            "label": {
              "ja": "パスワードでログイン",
              "en": "Sign in with a password"
            },
            "inputs": [
              "auth_password_hash"
            ]
          },
          {
            "id": "notification-push",
            "optional": true,
            "label": {
              "ja": "プッシュ通知",
              "en": "Push notifications"
            },
            "inputs": [
              "notification_push_gateway_url",
              "notification_push_gateway_token",
              "notification_push_web_push_public_key"
            ]
          }
        ]
      },
      "deploy/takoform": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            },
            "helper": {
              "ja": "ワークスペース内で使うYurucommuの名前です。",
              "en": "The name of this Yurucommu service in the workspace."
            },
            "advanced": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリース",
              "en": "Release"
            },
            "helper": {
              "ja": "配信する Yurucommu のリリースタグです。既定はこのリポジトリが固定した版です。",
              "en": "The Yurucommu release tag to serve. Defaults to the version this repository pins."
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "リリースURL",
              "en": "Release URL"
            },
            "helper": {
              "ja": "Worker 成果物の不変な HTTPS URL です。リリースタグと一致している必要があります。",
              "en": "Immutable HTTPS URL of the Worker artifact. It must match the release tag."
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリースSHA-256",
              "en": "Release SHA-256"
            },
            "helper": {
              "ja": "取得した成果物を検証する SHA-256 です。",
              "en": "SHA-256 that verifies the fetched artifact."
            },
            "advanced": true
          }
        ],
        "requires": [
          {
            "kind": "secret.generated",
            "bytes": 32,
            "encoding": "base64url",
            "deliver": {
              "bindings": {
                "value": "ENCRYPTION_KEY"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback/takos",
            "scopes": [
              "openid",
              "profile"
            ],
            "deliver": {
              "bindings": {
                "issuerUrl": "TAKOSUMI_ACCOUNTS_ISSUER_URL",
                "clientId": "TAKOSUMI_ACCOUNTS_CLIENT_ID",
                "ownerSubject": "TAKOSUMI_ACCOUNTS_OWNER_SUB",
                "redirectUri": "TAKOSUMI_ACCOUNTS_REDIRECT_URI"
              }
            }
          }
        ]
      }
    }
  }
}
