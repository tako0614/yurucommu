{
  "schemaVersion": "tcs.repo/v1",
  "id": "yurucommu",
  "modulePath": ".",
  "kind": "worker",
  "surface": "service",
  "provider": "cloudflare",
  "category": "social",
  "suggestedName": "yurucommu",
  "name": {
    "ja": "yurucommu",
    "en": "yurucommu"
  },
  "description": {
    "ja": "自分でホストできるコミュニティアプリです。",
    "en": "A self-hostable community app."
  },
  "badge": {
    "ja": "追加候補",
    "en": "Installable"
  },
  "iconUrl": "public/icons/yurucommu.svg",
  "inputs": [
    {
      "name": "project_name",
      "type": "string",
      "required": true,
      "defaultValue": "service-name",
      "label": { "ja": "サービス名", "en": "Service name" }
    },
    {
      "name": "worker_name",
      "type": "string",
      "format": "subdomain",
      "required": true,
      "defaultValue": "service-name",
      "label": { "ja": "公開URLの名前", "en": "Public URL name" },
      "helper": {
        "ja": "Takosumi Cloud では Workspace 名と組み合わせた app.takos.jp URLになります。",
        "en": "Takosumi Cloud combines this with the Workspace handle under app.takos.jp."
      }
    },
    {
      "name": "app_url",
      "type": "string",
      "format": "url",
      "advanced": true,
      "label": { "ja": "独自URL", "en": "Custom URL" }
    },
    {
      "name": "cloudflare_route_pattern",
      "type": "string",
      "advanced": true,
      "label": { "ja": "Cloudflare route", "en": "Cloudflare route" }
    },
    {
      "name": "auth_password_hash",
      "type": "string",
      "format": "password",
      "secret": true,
      "advanced": true,
      "label": {
        "ja": "追加のログインパスワード",
        "en": "Additional login password"
      },
      "helper": {
        "ja": "Takosumi Accounts の自動ログインに加えてパスワードでもログインしたい場合だけ設定します。",
        "en": "Set this only when password login should be available in addition to automatic Takosumi Accounts login."
      }
    }
  ],
  "installExperience": {
    "projections": [
      { "kind": "service_name", "variable": "project_name" },
      {
        "kind": "public_endpoint",
        "variables": {
          "subdomain": "worker_name",
          "url": "app_url",
          "routePattern": "cloudflare_route_pattern"
        },
        "baseDomain": "app.takos.jp"
      },
      {
        "kind": "initial_secret",
        "variable": "auth_password_hash",
        "secretKind": "password_or_hash",
        "optional": true
      },
      {
        "kind": "oidc_client",
        "variables": {
          "issuerUrl": "takosumi_accounts_issuer_url",
          "clientId": "takosumi_accounts_client_id"
        },
        "callbackPath": "/api/auth/callback/takos"
      }
    ]
  }
}
