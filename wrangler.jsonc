{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yurucommu",
  "main": "./dist/yurucommu-worker.js",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Replace this template value in the operator-owned realized config.
    "APP_URL": "https://REPLACE_WITH_HTTPS_ORIGIN",
    "DELIVERY_QUEUE_NAME": "yurucommu-delivery",
    "DELIVERY_DLQ_NAME": "yurucommu-delivery-dlq",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yurucommu-db",
      "migrations_dir": "node_modules/@takosjp/yurucommu-core/migrations",
      // One ledger, shared with the engine's own runners. Without this wrangler
      // keeps its own `d1_migrations` table, sees zero applied rows on a
      // database that `yurucommu_migrations` already migrated, and replays
      // 0001.. from the top — which re-runs table rebuilds against populated
      // tables. Both runners must agree on the ledger name or the second one
      // is destructive by construction.
      "migrations_table": "yurucommu_migrations",
    },
  ],
  // Retention sweep cadence. Matches the Bun self-host interval timer
  // (RETENTION_SWEEP_INTERVAL_MS) so both runtimes purge at the same rate;
  // every pass is LIMIT-bounded and the remainder rolls into the next run.
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "kv_namespaces": [{ "binding": "KV" }],
  "r2_buckets": [{ "binding": "MEDIA" }],
  "queues": {
    "producers": [
      { "binding": "DELIVERY_QUEUE", "queue": "yurucommu-delivery" },
      { "binding": "DELIVERY_DLQ", "queue": "yurucommu-delivery-dlq" },
    ],
    "consumers": [
      {
        "queue": "yurucommu-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "yurucommu-delivery-dlq",
      },
      {
        "queue": "yurucommu-delivery-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 60,
        "max_retries": 1,
      },
    ],
  },
}
