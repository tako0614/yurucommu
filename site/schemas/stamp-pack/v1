{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yurucommu.com/schemas/stamp-pack/v1",
  "title": "yurucommu Stamp Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "release",
    "name",
    "publisher",
    "visibility",
    "stamps"
  ],
  "properties": {
    "schema": {
      "const": "https://yurucommu.com/schemas/stamp-pack/v1"
    },
    "id": { "type": "string", "format": "uri", "maxLength": 2048 },
    "release": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "#/$defs/nameText" },
    "description": { "$ref": "#/$defs/descriptionText" },
    "publisher": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "Must have the same origin as the manifest id."
    },
    "visibility": { "enum": ["public", "unlisted"] },
    "icon": { "$ref": "#/$defs/asset" },
    "stamps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/stamp" }
    }
  },
  "$defs": {
    "nameText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[A-Za-z0-9-]{1,35}$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "descriptionText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[A-Za-z0-9-]{1,35}$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "altText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[A-Za-z0-9-]{1,35}$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "mediaType", "width", "height", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "mediaType": { "enum": ["image/webp", "image/png"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 512 },
        "height": { "type": "integer", "minimum": 1, "maximum": 512 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "revision", "alt", "tags", "assets"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "Must equal <manifest id without trailing slash>/stamps/<key>."
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "alt": { "$ref": "#/$defs/altText" },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    }
  }
}
