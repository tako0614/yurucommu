{
  "@context": {
    "story": "https://yurucommu.com/ns/story#",
    "apc": "https://yurucommu.com/ns/apc#",
    "yurucommu": {
      "@id": "https://yurucommu.com/ns/stamp#",
      "@prefix": true
    },
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "Story": "story:Story",
    "displayDuration": {
      "@id": "story:displayDuration",
      "@type": "xsd:duration"
    },
    "overlays": {
      "@id": "story:overlays",
      "@container": "@list"
    },
    "position": "story:position",

    "rooms": {
      "@id": "apc:rooms",
      "@type": "@id"
    },
    "joinPolicy": "apc:joinPolicy",
    "postPolicy": "apc:postPolicy",
    "visibility": "apc:visibility",
    "stamp": {
      "@id": "yurucommu:stamp",
      "@type": "@id"
    },
    "pack": {
      "@id": "yurucommu:pack",
      "@type": "@id"
    },
    "revision": "yurucommu:revision",
    "sha256": "yurucommu:sha256"
  }
}
